# ========================================================
# Power and Water Cut Alert & Reporting System
# Docker Compose environment configuration template
# ========================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration
# Compose uses MONGO_DB to build the internal MongoDB connection string.
# This URI is used by manual local development outside Docker.
MONGO_DB=power_water_alerts
MONGO_URI=mongodb://localhost:27017/power_water_alerts

# JWT Secret Key for Authentication
JWT_SECRET=supersecretjwtkey_change_in_production

# Frontend Client URL (for CORS allowance)
CLIENT_URL=http://localhost:3000

# The production client is served by Nginx, which proxies /api to the server.
VITE_API_BASE_URL=/api
