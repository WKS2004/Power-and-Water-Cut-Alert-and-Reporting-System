# ========================================================
# Power and Water Cut Alert & Reporting System
# Environment Variables Template (.env.example)
# ========================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Use mongodb://localhost:27017/power_water_alerts for local development without Docker
# Use mongodb://mongo:27017/power_water_alerts when running inside Docker Compose
MONGO_URI=mongodb://localhost:27017/power_water_alerts

# JWT Secret Key for Authentication
JWT_SECRET=supersecretjwtkey_change_in_production

# Frontend Client URL (for CORS allowance)
CLIENT_URL=http://localhost:3000

# Frontend Environment Variables (Vite requires VITE_ prefix)
VITE_API_BASE_URL=http://localhost:5000/api
