# ========================================================
# Power and Water Cut Alert & Reporting System
# Docker Compose environment configuration template
# ========================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration
# Cloud MongoDB Atlas connection string used by both Docker and local runs.
# Replace the placeholders with your Atlas database user, password, and cluster.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/power_water_alerts?retryWrites=true&w=majority

# JWT Secret Key for Authentication
JWT_SECRET=supersecretjwtkey_change_in_production

# Frontend Client URL (for CORS allowance)
# Local: CLIENT_URL=http://localhost:3000
# Production:
CLIENT_URL=https://power-and-water-cut-alert-and-repor.vercel.app

# Backend Server URL & API Base
# Local: VITE_API_BASE_URL=/api
# Production:
SERVER_URL=https://power-and-water-cut-alert-and-reporting-6377.onrender.com
VITE_API_BASE_URL=https://power-and-water-cut-alert-and-reporting-6377.onrender.com/api
